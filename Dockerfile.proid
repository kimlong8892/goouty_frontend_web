FROM node:18-slim

# Đặt thư mục làm việc
WORKDIR /usr/src/app

# Copy package.json và package-lock.json
COPY package*.json ./

# Cài dependencies (cả dev để chạy build)
RUN npm install

# Copy toàn bộ source code
COPY . .

# Build app cho production
RUN npm run build

# Expose port (Vite mặc định 5173)
EXPOSE 8080

# Command mặc định: chạy dev server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
